{
  "name": "poc-frontend-nodejs",
  "version": "1.0.0",
  "description": "Frontend Node.js da POC Kubernetes local (healthz, métricas Prometheus, logs JSON)",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage",
    "lint": "node --check src/server.js && node --check src/app.js && node --check src/metrics.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "express": "^4.21.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"],
    "coverageReporters": ["text", "lcov"],
    "coverageThreshold": { "global": { "lines": 80, "branches": 70 } }
  }
}
